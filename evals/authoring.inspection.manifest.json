{
  "version": 1,
  "probes": [
    {
      "id": "status-schema",
      "probe": "output-schema",
      "access": "read_only",
      "tool": "adobe_status",
      "arguments": {
        "application": "photoshop"
      }
    },
    {
      "id": "status-outcome",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "adobe_status",
      "arguments": {
        "application": "photoshop"
      },
      "expect": {
        "outcome": "ok",
        "equals_paths": {
          "/structuredContent/running": true,
          "/structuredContent/launches_application": false,
          "/structuredContent/authenticates": false
        }
      }
    },
    {
      "id": "inspect-schema",
      "probe": "output-schema",
      "access": "read_only",
      "tool": "adobe_inspect",
      "arguments": {
        "application": "photoshop"
      }
    },
    {
      "id": "inspect-outcome",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "adobe_inspect",
      "arguments": {
        "application": "photoshop"
      },
      "expect": {
        "outcome": "ok",
        "equals_paths": {
          "/structuredContent/runtime/running": true,
          "/structuredContent/pending_operation": null
        },
        "required_result_paths": [
          "/structuredContent/documents"
        ]
      }
    },
    {
      "id": "generative-fill-rejects-bounds",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "adobe_generative_fill",
      "arguments": {
        "application": "photoshop",
        "session_id": "unused",
        "prompt": "sky",
        "bounds": [0, 0, 10]
      },
      "expect": {
        "outcome": "error"
      }
    },
    {
      "id": "remove-background-rejects-layer-path",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "adobe_remove_background",
      "arguments": {
        "application": "photoshop",
        "session_id": "unused",
        "layer_path": [],
        "expected_name": "Layer 1"
      },
      "expect": {
        "outcome": "error"
      }
    },
    {
      "id": "generative-upscale-rejects-application",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "adobe_generative_upscale",
      "arguments": {
        "application": "illustrator",
        "session_id": "unused"
      },
      "expect": {
        "outcome": "error"
      }
    },
    {
      "id": "read-sequence",
      "probe": "workflow",
      "access": "read_only",
      "repetitions": 3,
      "steps": [
        {
          "tool": "adobe_status",
          "arguments": {
            "application": "photoshop"
          },
          "expect": {
            "outcome": "ok",
            "equals_paths": {
              "/structuredContent/running": true,
              "/structuredContent/launches_application": false,
              "/structuredContent/authenticates": false
            }
          }
        },
        {
          "tool": "adobe_inspect",
          "arguments": {
            "application": "photoshop"
          },
          "expect": {
            "outcome": "ok",
            "equals_paths": {
              "/structuredContent/runtime/running": true,
              "/structuredContent/pending_operation": null
            },
            "required_result_paths": [
              "/structuredContent/documents"
            ]
          }
        },
        {
          "tool": "adobe_status",
          "arguments": {
            "application": "photoshop"
          },
          "expect": {
            "outcome": "ok",
            "equals_paths": {
              "/structuredContent/running": true,
              "/structuredContent/launches_application": false,
              "/structuredContent/authenticates": false
            }
          }
        }
      ]
    }
  ]
}
