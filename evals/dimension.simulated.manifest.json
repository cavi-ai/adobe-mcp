{
  "version": 1,
  "probes": [
    {
      "id": "status-schema",
      "probe": "output-schema",
      "access": "read_only",
      "tool": "dimension_status",
      "arguments": {}
    },
    {
      "id": "status-outcome",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "dimension_status",
      "arguments": {},
      "expect": {
        "outcome": "ok",
        "equals_paths": {
