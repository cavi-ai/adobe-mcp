      "id": "inspect-outcome",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "dimension_inspect",
      "arguments": {},
      "expect": {
        "outcome": "ok",
        "equals_paths": {
          "/structuredContent/native/running": true,
          "/structuredContent/launches_application": false
        },
        "required_result_paths": [
