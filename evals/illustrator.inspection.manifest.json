{
  "version": 1,
  "probes": [
    {
      "id": "status-schema",
      "probe": "output-schema",
      "access": "read_only",
      "tool": "illustrator_status",
      "arguments": {}
    },
    {
      "id": "status-outcome",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "illustrator_status",
      "arguments": {},
      "expect": {
        "outcome": "ok",
        "equals_paths": {
          "/structuredContent/running": true,
          "/structuredContent/launches_application": false,
          "/structuredContent/authenticates": false
        }
      }
    },
    {
      "id": "inspect-schema",
      "probe": "output-schema",
      "access": "read_only",
      "tool": "illustrator_inspect",
      "arguments": {}
    },
    {
      "id": "inspect-outcome",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "illustrator_inspect",
      "arguments": {},
      "expect": {
        "outcome": "ok",
        "equals_paths": {
          "/structuredContent/runtime/running": true,
          "/structuredContent/pending_operation": null
        },
        "required_result_paths": [
          "/structuredContent/documents"
        ]
      }
    },
    {
      "id": "export-rejects-kind",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "illustrator_export",
      "arguments": {
        "session_id": "unused",
        "destination": "out.svg",
        "kind": "jpeg"
      },
      "expect": {
        "outcome": "error"
      }
    },
    {
      "id": "set-text-font-rejects-frame-index",
      "probe": "instruction-fidelity",
      "access": "read_only",
      "tool": "illustrator_set_text_font",
      "arguments": {
        "session_id": "unused",
        "layer_path": [0],
        "expected_name": "Layer 1",
        "frame_index": -1,
        "font": "ArialMT"
      },
      "expect": {
        "outcome": "error"
      }
    },
    {
      "id": "read-sequence",
      "probe": "workflow",
      "access": "read_only",
      "repetitions": 3,
      "steps": [
        {
          "tool": "illustrator_status",
          "arguments": {},
          "expect": {
            "outcome": "ok",
            "equals_paths": {
              "/structuredContent/running": true,
              "/structuredContent/launches_application": false,
              "/structuredContent/authenticates": false
            }
          }
        },
        {
          "tool": "illustrator_inspect",
          "arguments": {},
          "expect": {
            "outcome": "ok",
            "equals_paths": {
              "/structuredContent/runtime/running": true,
              "/structuredContent/pending_operation": null
            },
            "required_result_paths": [
              "/structuredContent/documents"
            ]
          }
        },
        {
          "tool": "illustrator_status",
          "arguments": {},
          "expect": {
            "outcome": "ok",
            "equals_paths": {
              "/structuredContent/running": true,
              "/structuredContent/launches_application": false,
              "/structuredContent/authenticates": false
            }
          }
        }
      ]
    }
  ]
}
